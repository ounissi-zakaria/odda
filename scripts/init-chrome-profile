#!/usr/bin/env python3
"""Launch Chrome with a persistent profile at the base profile directory.

Use this to configure Chrome settings, extensions, and preferences once.
The odda server will copy this profile for each isolated browser session.
"""

import shutil
import subprocess
import sys
from pathlib import Path

_BASE_PROFILE_DIR = Path.home() / ".config" / "odda" / "chrome-profile"

# Chrome flags that match what odda passes at runtime
_MATCHING_FLAGS = [
    "--no-first-run",
    "--no-default-browser-check",
]


class ChromeNotFoundError(RuntimeError):
    """Chrome/Chromium executable could not be found."""


class ProfileLockedError(RuntimeError):
    """The base profile directory is locked by another Chrome instance."""


def _find_chrome() -> str:
    """Find a Chrome/Chromium executable on the system.

    Returns:
        Path to the Chrome executable.

    Raises:
        ChromeNotFoundError: If no Chrome installation is found.
    """
    candidates = [
        "google-chrome",
        "google-chrome-stable",
        "google-chrome-beta",
        "google-chrome-unstable",
        "chromium",
        "chromium-browser",
        "chrome",
    ]
    for name in candidates:
        path = shutil.which(name)
        if path:
            return path

    # Check common non-PATH locations
    common_paths = [
        "/usr/bin/google-chrome",
        "/usr/bin/google-chrome-stable",
        "/usr/bin/chromium",
        "/usr/bin/chromium-browser",
        "/snap/bin/chromium",
    ]
    for path in common_paths:
        if Path(path).is_file() and Path(path).stat().st_mode & 0o111:
            return path

    raise ChromeNotFoundError(
        "Chrome/Chromium not found. Install Chrome or ensure it is in PATH."
    )


def _ensure_profile_unlocked(profile_dir: Path) -> None:
    """Check that the base profile directory is not in use by another Chrome instance.

    Args:
        profile_dir: The base profile directory path.

    Raises:
        ProfileLockedError: If the profile appears to be locked.
    """
    if profile_dir.exists() and (profile_dir / "SingletonLock").exists():
        raise ProfileLockedError(
            f"Profile directory {profile_dir} appears to be locked "
            "by another Chrome instance. Close it first."
        )


def main():
    """Run the init-profile script."""
    chrome = _find_chrome()
    profile_dir = _BASE_PROFILE_DIR
    profile_dir.mkdir(parents=True, exist_ok=True)

    _ensure_profile_unlocked(profile_dir)

    args = [chrome, f"--user-data-dir={profile_dir}", *_MATCHING_FLAGS]
    print(f"Launching: {' '.join(args)}")

    subprocess.run(args, check=True)  # noqa: S603


if __name__ == "__main__":
    sys.exit(main())
